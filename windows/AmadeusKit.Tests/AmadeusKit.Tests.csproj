<!-- The kit's tests (ports of mac/Tests/AmadeusKitTests and more): `dotnet test`, on a Mac too. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\AmadeusKit\AmadeusKit.csproj" />
    <None Include="Samples\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- the stacks' arithmetic, from the app (pure C#: tested here) -->
    <Compile Include="..\AmadeusDMX\Shared\StackLayout.cs" Link="App\StackLayout.cs" />
    <!-- the rig editor's model, undo and self test, from the app (no WinUI: tested here), with the stage's input -->
    <Using Include="AmadeusKit" />
    <Compile Include="..\AmadeusDMX\Render\StageInput.cs" Link="App\StageInput.cs" />
    <Compile Include="..\AmadeusDMX\Rig\Editor\StageEditing.cs" Link="App\Rig\StageEditing.cs" />
    <Compile Include="..\AmadeusDMX\Rig\Editor\UndoManager.cs" Link="App\Rig\UndoManager.cs" />
    <Compile Include="..\AmadeusDMX\Rig\Editor\RigEditorHost.cs" Link="App\Rig\RigEditorHost.cs" />
    <Compile Include="..\AmadeusDMX\Rig\Editor\RigEditorModel.cs" Link="App\Rig\RigEditorModel.cs" />
    <Compile Include="..\AmadeusDMX\Rig\Editor\EditorSelfTest.cs" Link="App\Rig\EditorSelfTest.cs" />
  </ItemGroup>
</Project>
